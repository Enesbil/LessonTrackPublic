RESPONSE_CSV_URL='https://docs.google.com/spreadsheets/d/YOUR_RESPONSE_SHEET_ID/export?format=csv'
REPRESENTATIVE_CSV_URL='https://docs.google.com/spreadsheets/d/YOUR_REPRESENTATIVE_SHEET_ID/export?format=csv&gid=0'
FORM_URL='https://forms.gle/YOUR_FORM_ID'
DRIVE_FOLDER_URL='https://drive.google.com/drive/folders/YOUR_FOLDER_ID'
SENDER_EMAIL='sender@example.com'
MANAGEMENT_EMAILS='manager@example.com'
OPENAI_API_KEY='YOUR_OPENAI_API_KEY'
GMAIL_APP_PASSWORD='YOUR_GMAIL_APP_PASSWORD'
# Use either a local service account file or SHEETS_CREDENTIALS_JSON.
SHEETS_CREDENTIALS_FILE='./sheets_credentials.json'
# Optional: local Gmail OAuth fallback token.
GMAIL_TOKEN_FILE='./gmail_token.json'
